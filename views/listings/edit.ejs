<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit <%= onelist.title%>
  </title>
</head>

<body>
  <h1>Edit Place</h1>
  <form method="post" action="/listings/<%= onelist._id%>?_method=PUT">
    <img src="<%=onelist.image.url %>" name="Listing[image]" height="350px"><br><br>

    <label for="Listing[title]">Title :- </label>
    <input type="text" value="<%=onelist.title %>" name="Listing[title]"> <br><br>

    <label for="Listing[description]">Description :- </label>
    <input type="text" value="<%=onelist.description %>" row="4" name="Listing[description]"> <br><br>

    <label for="Listing[country]">Country :- </label>
    <input type="text" value="<%=onelist.country %>" name="Listing[country]"><br><br>

    <label for="Listing[price]">price :- </label>
    <input type="number" value="<%=onelist.price %>" name="Listing[price]"><br><br>

    <label for="Listing[location]">Location :- </label>
    <input type="text" value="<%=onelist.location %>" name="Listing[location]"><br><br>

    <button type="submit">Update <%= onelist.title%></button>
  </form>
</body>

</html>