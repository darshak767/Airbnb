<% layout('layouts/boilerplate') -%>

<div class="listing-form">

  <h1 class="mb-4">Edit <%= onelist.title %></h1>

  <form method="post" action="/listings/<%= onelist._id %>?_method=PUT">

    <div class="edit-image mb-4">
      <img
        src="<%= onelist.image.url %>"
        alt="<%= onelist.title %>"
      >
    </div>

    <div class="mb-3">
      <label for="title" class="form-label">Title</label>
      <input
        type="text"
        class="form-control"
        id="title"
        value="<%= onelist.title %>"
        name="Listing[title]"
      >
    </div>

    <div class="mb-3">
      <label for="description" class="form-label">Description</label>
      <textarea
        class="form-control"
        id="description"
        name="Listing[description]"
        rows="4"
      ><%= onelist.description %></textarea>
    </div>

    <div class="row">

      <div class="col-md-6 mb-3">
        <label for="country" class="form-label">Country</label>
        <input
          type="text"
          class="form-control"
          id="country"
          value="<%= onelist.country %>"
          name="Listing[country]"
        >
      </div>

      <div class="col-md-6 mb-3">
        <label for="price" class="form-label">Price</label>
        <input
          type="number"
          class="form-control"
          id="price"
          value="<%= onelist.price %>"
          name="Listing[price]"
        >
      </div>

    </div>

    <div class="mb-4">
      <label for="location" class="form-label">Location</label>
      <input
        type="text"
        class="form-control"
        id="location"
        value="<%= onelist.location %>"
        name="Listing[location]"
      >
    </div>

    <button type="submit" class="btn btn-dark">
      Update <%= onelist.title %>
    </button>

  </form>

</div>