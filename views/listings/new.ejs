<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New Place</title>
  <style>
    body {
      font-size: 20px;
    }
  </style>
</head>

<body>
  <h1>Add New Place</h1>
  <form method="post" action="/listing">
    <input type="text" placeholder="enter title here.." name="title"> <br><br>
    <textarea name="description" placeholder="enter description"></textarea> <br><br>
    <input type="text" placeholder="enter image here.." name="img"> <br><br>
    <input type="text" placeholder="enter country name here.." name="country"> <br><br>
    <input type="number" placeholder="enter country price here.." name="price"><br><br>
    <input type="text" placeholder="enter location here.." name="location"><br><br>
    <input type="number" placeholder="enter number here.." name="phone"><br><br>
    <button type="submit">Add</button>
  </form>
</body>

</html>