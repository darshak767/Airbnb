<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WanderLaust</title>
</head>
<!-- show all list of places -->

<body>
  <h1>Show All Lists</h1>

  <form method="get" action="/listing/new">
    <button>Add New Place</button>
  </form>

  <% for(let list of listsAll){ %>
    <div><a href="/listing/<%= list._id %>">
        <%= list.title %>
      </a>
    </div>
    <div>description:-
      <%= list.description %>
    </div>
    <br><br>
    <hr>
    <% } %>
</body>

</html>