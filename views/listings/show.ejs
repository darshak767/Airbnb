<% layout('layouts/boilerplate') -%>

  <div class="listing-form">

    <h1 class="mb-4">Listing Details</h1>

    <div class="show-card">

      <img src="<%= onelist.image.url %>" class="show-image" alt="<%= onelist.title %>">

      <div class="show-details">

        <h2>
          <%= onelist.title %>
        </h2>

        <p><strong>Description:</strong>
          <%= onelist.description %>
        </p>

        <p>
          <strong>Price:</strong>
          ₹<%= onelist.price.toLocaleString('en-IN') %>
        </p>

        <p><strong>Location:</strong>
          <%= onelist.location %>
        </p>

        <p><strong>Country:</strong>
          <%= onelist.country %>
        </p>

        <div class="listing-actions mt-4 d-flex gap-2">

          <form method="get" action="/listings/<%= onelist._id %>/edit">
            <button type="submit" class="btn btn-dark">
              Edit Listing
            </button>
          </form>

          <form method="post" action="/listings/<%= onelist._id %>?_method=DELETE">
            <button type="submit" class="btn btn-outline-danger">
              Delete Listing
            </button>
          </form>

        </div>

      </div>

    </div>

    <div class="reviews-section">
      <h4>leave review :</h4>
      <form action="/listings/<%= onelist._id %>/reviews" method="POST">
        <div class="mb-3">
          <output for="review-rating" id="review-rating-value">1 </output> Stars
          <label for="review-rating" class="form-label">Rating</label>

          <input type="range" min="1" max="5" value="1" name="review[rating]" id="review-rating" class="form-range">


          <label for="review-comment" class="form-label">Comment :-</label>
          <textarea name="review[comment]" id="review-comment" class="form-control"
            placeholder="Enter your feedback..."></textarea>
          <div class="invalid-feedback">
            Please enter a valid feedback.
          </div>
        </div>
        <button type="submit" class="btn btn-dark mt-2">Submit</button>
      </form>

      <h4>All Reviews</h4>
      <div class="reviews-grid">
        <% for(let review of onelist.reviews){ %>
          <div class="card">
            <div class="card-body">
              <h5 class="card-title">Rating: <%= review.rating %> Stars</h5>
              <p class="card-text">
                <%= review.comment %>
              </p>

              <form method="post" action="/listings/<%= onelist._id %>/reviews/<%= review._id %>?_method=DELETE">
                <button type="submit" class="btn btn-outline-danger">Delete Review</button>
              </form>

            </div>
          </div>
          <% } %>
      </div>
    </div>

  </div>