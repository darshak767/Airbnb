<% layout('layouts/boilerplate') -%>

  <div class="listing-form">

    <h1 class="mb-4">Listing Details</h1>

    <div class="show-card">

      <img src="<%= (onelist.image && onelist.image.url) ? onelist.image.url : '/img/default-image.jpg' %>"
        class="show-image" alt="<%= onelist.title %>" onerror="this.onerror=null;this.src='/img/default-image.jpg';">

      <div class="show-details">

        <h2>
          <%= onelist.title %>
        </h2>
        <p><strong>Owner:</strong>
          <%= onelist.owner.username %>
        </p>

        <p><strong>Description:</strong>
          <%= onelist.description %>
        </p>

        <p>
          <strong>Price:</strong>
          ₹<%= onelist.price.toLocaleString('en-IN') %>
        </p>

        <p><strong>Location:</strong>
          <%= onelist.location %>
        </p>

        <p><strong>Country:</strong>
          <%= onelist.country %>
        </p>
        <% if(currentUser && currentUser._id.equals(onelist.owner._id)){ %>
          <div class="listing-actions mt-4 d-flex gap-2">

            <form method="get" action="/listings/<%= onelist._id %>/edit">
              <button type="submit" class="btn btn-dark">
                Edit Listing
              </button>
            </form>

            <form method="post" action="/listings/<%= onelist._id %>?_method=DELETE">
              <button type="submit" class="btn btn-outline-danger">
                Delete Listing
              </button>
            </form>
          </div>
          <% } %>
      </div>

    </div>

    <% if(currentUser) {%>
      <div class="reviews-section">
        <h4>Leave a Review</h4>
        <form action="/listings/<%= onelist._id %>/reviews" method="POST" novalidate class="needs-validation">
          <div class="mb-3">
            <fieldset class="starability-slot">
              <legend>Rating :</legend>
              <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked
                aria-label="No rating." />
              <input type="radio" id="first-rate1" name="review[rating]" value="1" />
              <label for="first-rate1" title="Terrible">1 star</label>
              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2" title="Not good">2 stars</label>
              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3" title="Average">3 stars</label>
              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4" title="Very good">4 stars</label>
              <input type="radio" id="first-rate5" name="review[rating]" value="5" />
              <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>

            <label for="review-comment" class="form-label mt-2">Comment :-</label>
            <textarea name="review[comment]" id="review-comment" class="form-control"
              placeholder="Enter your feedback..." required></textarea>
            <div class="invalid-feedback">
              Please enter a valid feedback.
            </div>
          </div>
          <button type="submit" class="btn btn-dark mt-2">Submit</button>
        </form>
      </div>
    <% }%>

    <% if(onelist.reviews.length> 0) {%>
      <div class="reviews-section">
        <h4>All Reviews</h4>
        <div class="reviews-grid">
          <% for(let review of onelist.reviews){ %>
            <div class="card">
              <div class="card-body">
                <p class="starability-result" data-rating="<%= review.rating %>">
                  Rated: <%= review.rating %> stars
                </p>
                <h5 class="card-title">Author: @<%= review.author.username %>
                </h5>
                <p class="card-text">
                  <%= review.comment %>
                </p>

                <% if(currentUser && review.author && review.author._id.equals(currentUser._id)) { %>
                  <form method="post" action="/listings/<%= onelist._id %>/reviews/<%= review._id %>">
                    <input type="hidden" name="_method" value="DELETE">
                    <button type="submit" class="btn btn-outline-danger">Delete Review</button>
                  </form>
                <% } %>

              </div>
            </div>
          <% } %>
        </div>
      </div>
    <% } %>

    <div class="map-section mt-4 mb-4">
      <h4>Where you'll be</h4>
      <div id="map"></div>
    </div>

  </div>

  <script id="listing-data" type="application/json">
    <%- JSON.stringify(onelist).replace(/</g, '\\u003c') %>
  </script>
  <script>
    const mapToken = "<%= mapToken || process.env.MAP_TOKAN || process.env.MAP_TOKEN || '' %>";
    const listing = JSON.parse(document.getElementById("listing-data").textContent);
  </script>
  <script src="/js/map.js"></script>
