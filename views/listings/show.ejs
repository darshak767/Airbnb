<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= onelist.title %> Details
  </title>
</head>
<!-- show only one list details -->
<body>
  <h1>Listing Details</h1>
  <div>
    <img src="<%= onelist.image.url %>" height="300px">
    <p>TItle :
      <%= onelist.title%>
    </p>
    <p>Description :
      <%= onelist.description%>
    </p>
    <p>price :&#8377;
      <%= onelist.price.toLocaleString('en-IN') %>
    </p>
    <p>location :
      <%= onelist.location%>
    </p>
    <p>country :
      <%= onelist.country%>
    </p>
  </div>
</body>

</html>